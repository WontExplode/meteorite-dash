#!/usr/bin/env bash
set -e

echo "=== ruff format --check ==="
uv run ruff format --check .

echo "=== ruff check ==="
uv run ruff check .

echo "=== mypy ==="
uv run mypy .

echo "=== interrogate ==="
uv run interrogate

echo "=== pytest ==="
uv run pytest || test $? -eq 5

echo "All checks passed."
